package [[.AppName]]

import (
	"net/http"

	"github.com/oliverhaas/djangogo/orm"
	"github.com/oliverhaas/djangogo/views"
)

// postList shows the published posts, the newest first.
func (a *App) postList() http.Handler {
	return views.ListView[Post]{
		DB:                a.db,
		Engine:            a.templates,
		TemplateName:      "[[.AppName]]/post_list.html",
		ContextObjectName: "posts",
		GetQueryset: func(*http.Request) (*orm.QuerySet[Post], error) {
			return orm.Query[Post](a.db).Filter("published", true).OrderBy("-id"), nil
		},
	}
}

// postDetail shows the post whose primary key is in the URL.
func (a *App) postDetail() http.Handler {
	return views.DetailView[Post]{
		DB:                a.db,
		Engine:            a.templates,
		TemplateName:      "[[.AppName]]/post_detail.html",
		ContextObjectName: "post",
	}
}
