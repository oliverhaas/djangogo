package main

import "github.com/oliverhaas/djangogo/conf"

// settings returns the settings of the project, Django's settings.py. They
// start from Django's defaults, the values set here replace those, and the
// environment replaces both: DJANGOGO_DEBUG=false, DJANGOGO_SECRET_KEY,
// DJANGOGO_ALLOWED_HOSTS=example.com,www.example.com or a DATABASE_URL such
// as postgres://user:password@localhost:5432/[[.Name]], set in the process
// environment or in a .env file.
func settings() (conf.Settings, error) {
	s := conf.Defaults()

	// SECURITY WARNING: keep the secret key used in production secret. Set
	// DJANGOGO_SECRET_KEY in production.
	s.SecretKey = "[[.SecretKey]]"

	// SECURITY WARNING: don't run with debug turned on in production.
	s.Debug = true

	s.AllowedHosts = []string{}

	s.Database = conf.Database{Driver: conf.DriverSQLite, DSN: "db.sqlite3"}

	// Static files (CSS, JavaScript, images). collectstatic copies them into
	// StaticRoot for the web server in front of the project.
	s.StaticURL = "/static/"
	s.StaticRoot = "staticfiles"

	if err := conf.LoadDotEnv(); err != nil {
		return s, err
	}
	if err := s.ApplyEnv("DJANGOGO_"); err != nil {
		return s, err
	}
	return s, nil
}
